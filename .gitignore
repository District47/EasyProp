# --- Build output ---
build/
out/
[Bb]in/
[Oo]bj/
*.o
*.obj
*.exe
splat
splat-hd

# --- Generated configuration headers ---
# splat.h is generated by the legacy bash build (copied from std/hd-parms.h);
# splat_config.h is generated by CMake's configure_file().
splat.h
std-parms.h
hd-parms.h
splat_config.h
src/splat_config.h

# --- SPLAT! runtime/output artifacts ---
# Note: these are generated in the working dir at runtime. We intentionally
# do NOT ignore anything under sample_data/ (those are upstream inputs,
# including wnju-dt.scf signal-color and the .az/.el antenna-pattern files).
# Documentation screenshots under viewer/screenshots/ are also tracked.
*.ppm
*.png
*.kml
*.geo
*.gp
*.dot
sample_data/sdf/
!sample_data/**
!viewer/screenshots/**

# --- Dependencies / package managers ---
vcpkg_installed/
[Vv]cpkg/

# --- IDE / editor ---
.vs/
.vscode/
*.user
CMakeUserPresets.json

# --- OS noise ---
Thumbs.db
desktop.ini
.DS_Store

# --- Claude Code harness state (per-machine, never tracked) ---
.claude/

# Release artifacts (built by scripts/build_release.ps1, uploaded to GitHub Releases)
EasyProp-win-*.zip
