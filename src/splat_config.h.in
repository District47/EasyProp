/****************************************************************************
*  splat_config.h  --  Generated by CMake from src/splat_config.h.in.       *
*  DO NOT EDIT this generated file; edit the .in template instead.          *
*                                                                           *
*  This replaces the legacy build-time-generated "splat.h" that the old     *
*  interactive ./configure + ./build bash scripts produced.  The resolution *
*  mode and maximum analysis-region size are now chosen at CMake configure  *
*  time via the SPLAT_HD_MODE and SPLAT_MAXPAGES cache variables.           *
\****************************************************************************/

#ifndef SPLAT_CONFIG_H
#define SPLAT_CONFIG_H

/* SPLAT! version string (was hard-coded in splat.cpp; centralized here). */
#define SPLAT_VERSION_STRING "@PROJECT_VERSION@"

/* Resolution mode:
     0 = standard definition (3 arc-second data, IPPD 1200)
     1 = high definition     (1 arc-second data, IPPD 3600)            */
#define HD_MODE @SPLAT_HD_MODE@

/* Maximum analysis region, in square degrees.  Must be a perfect square
   from {1,4,9,16,25,36,49,64}.  Larger values need proportionally more
   memory (see the RAM table in the original ./configure script).      */
#define MAXPAGES @SPLAT_MAXPAGES@

#endif /* SPLAT_CONFIG_H */
